FROM modelscope-registry.cn-hangzhou.cr.aliyuncs.com/modelscope-repo/modelscope:ubuntu22.04-cuda12.8.1-py311-torch2.9.0-vllm0.13.0-modelscope1.33.0-swift3.12.1

RUN pip install fastapi uvicorn httpx
RUN pip install 'ms-swift' transformers
RUN pip install "autoawq" -U
RUN pip install huggingface_hub

# Install utilities for download
RUN apt-get update && apt-get install -y curl unzip wget

# Download Base Model
RUN mkdir -p /model/base_model
RUN --mount=type=secret,id=HF_TOKEN,env=HF_TOKEN,required=true \
    huggingface-cli download --local-dir /model/base_model hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4

# Download Adapters from GitHub Releases
# URL for v0.1.0 tag, file output-20260120.zip
RUN mkdir -p /model/adapters
RUN --mount=type=secret,id=GITHUB_TOKEN,env=GITHUB_TOKEN,required=true \
    curl -L -H "Authorization: token $GITHUB_TOKEN" -o /model/adapters.zip https://github.com/AI-Fin-Fraud-Detector/scam-call-llm/releases/download/v0.1.0/output-20260120.zip \
    && unzip /model/adapters.zip -d /model/adapters \
    && rm -rf /model/adapters.zip

WORKDIR ${PROJECT_PATH}


# vLLM serves only the scam classifier. The butler chat model runs as its own service (butler-llm).
# VLLM_GPU_MEMORY_UTILIZATION (default 0.60) leaves room on the same GPU for butler-llm; set it in docker-compose.yml.
ENV VLLM_GPU_MEMORY_UTILIZATION=0.60
CMD ["bash", "-c", "vllm serve /model/base_model \
    --enable-lora \
    --lora-modules scam-8b-sft=/model/adapters/output/llama31_8b_scam_real_sft_v4/v0-20260117-075831/checkpoint-108 \
    --max-loras 1 \
    --max-lora-rank 16 \
    --max-model-len 12288 \
    --gpu-memory-utilization ${VLLM_GPU_MEMORY_UTILIZATION} \
    --enforce-eager \
    --host 0.0.0.0 --port 8000"]
